#!/bin/bash
# Compatible with the Bash 3.2 shipped by macOS.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage:
  vm-studio <input.qta> <output.ogg> <intensity 0...1>
  vm-studio --lossless <input.qta> <output.m4a> <intensity 0...1>

Default: Ogg Opus, mono, 48 kHz, 64 kbps VBR
Lossless: ALAC in M4A, stereo, 48 kHz, 32-bit
Existing destinations are never overwritten. Sources are never deleted.
USAGE
  exit 64
}

LOSSLESS=0
if [[ "${1:-}" == "--lossless" ]]; then
  LOSSLESS=1
  shift
fi
[[ $# -eq 3 ]] || usage
INPUT=$1
OUTPUT=$2
INTENSITY=$3
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RENDERER="$SCRIPT_DIR/vm-studio-lossless"

for tool in ffmpeg ffprobe python3; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "ERROR: $tool is required." >&2
    exit 69
  }
done
[[ -f "$INPUT" && -r "$INPUT" ]] || {
  echo "ERROR: input not found/readable: $INPUT" >&2
  exit 66
}
[[ -x "$RENDERER" ]] || {
  echo "ERROR: renderer binary not found: $RENDERER. Run make first." >&2
  exit 69
}
if [[ $LOSSLESS -eq 1 ]]; then
  [[ "$OUTPUT" == *.m4a ]] || usage
else
  [[ "$OUTPUT" == *.ogg ]] || usage
fi
[[ ! -e "$OUTPUT" && ! -L "$OUTPUT" ]] || {
  echo "ERROR: destination already exists; nothing overwritten: $OUTPUT" >&2
  exit 73
}
# Validate before rendering or creating temporary files; NaN and infinity fail.
python3 "$SCRIPT_DIR/verify-export.py" preflight "$INPUT" "$OUTPUT" "$INTENSITY"

# Make paths absolute so filenames beginning with '-' are not CLI options.
INPUT="$(cd -- "$(dirname -- "$INPUT")" && pwd)/$(basename -- "$INPUT")"
mkdir -p -- "$(dirname -- "$OUTPUT")"
OUTPUT="$(cd -- "$(dirname -- "$OUTPUT")" && pwd)/$(basename -- "$OUTPUT")"
# Stage on the destination filesystem to allow atomic, no-clobber publication.
TMP_DIR="$(mktemp -d "$(dirname -- "$OUTPUT")/.vm-studio.XXXXXX")"
cleanup() { rm -rf -- "$TMP_DIR"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
LOSSLESS_RENDER="$TMP_DIR/render.m4a"
PARTIAL_OUTPUT="$TMP_DIR/output.ogg"

# Detach the core from a caller's heredoc as well.
"$RENDERER" "$INPUT" "$LOSSLESS_RENDER" "$INTENSITY" </dev/null
python3 "$SCRIPT_DIR/verify-export.py" verify "$INPUT" "$LOSSLESS_RENDER" lossless
ffmpeg -nostdin -v error -xerror -err_detect explode \
  -i "$LOSSLESS_RENDER" -map 0:a:0 -f null -

if [[ $LOSSLESS -eq 1 ]]; then
  FINAL_STAGE="$LOSSLESS_RENDER"
else
  ffmpeg -nostdin -hide_banner -loglevel error -xerror -err_detect explode -n \
    -i "$LOSSLESS_RENDER" -map 0:a:0 -vn -sn -dn \
    -ac 1 -ar 48000 -c:a libopus -b:a 64k -vbr on \
    -compression_level 10 -application audio -map_metadata -1 \
    -f ogg "$PARTIAL_OUTPUT"
  python3 "$SCRIPT_DIR/verify-export.py" verify "$INPUT" "$PARTIAL_OUTPUT" opus
  ffmpeg -nostdin -v error -xerror -err_detect explode \
    -i "$PARTIAL_OUTPUT" -map 0:a:0 -f null -
  FINAL_STAGE="$PARTIAL_OUTPUT"
fi

python3 "$SCRIPT_DIR/verify-export.py" publish "$FINAL_STAGE" "$OUTPUT"
echo "Rendered and verified: $OUTPUT"
echo "Studio Voice intensity: $INTENSITY"
echo "Sources are retained. Listen to the beginning, middle, and end before considering source deletion."
